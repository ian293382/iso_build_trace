# 使用scripts 檔案前 請先 sudo su
#
# 所在目錄
#   ├─ tool: 放置欲iso build的檔案
#   ├─ scripts: 腳本放置區 (從iso_build裡複製出來。之後所有流程都會在這個目錄下操作。)
#   │     └─ 0_config: 初始設定檔
#   ├─ source-files: 還原iso內容的目錄
#   ├─ output: 放置 iso_build完的 iso
#   └─ iso_build: bitbucket download 下來的iso build專案

# ===============【部署設定】===============
# ISO安裝檔名稱 _P.S. *.iso 適用於目錄只會有一個iso檔，可不指定名稱_
INSTALL_ISO_FILENAME='*.iso' # 不指定名稱
#INSTALL_ISO_FILENAME='ubuntu-20.04.4-live-server-amd64.iso' # 指定名稱
#INSTALL_ISO_FILENAME='4.0test.iso' # 測試用

# 解壓縮(unpack)後的輸出檔案名稱
UNPACK_OUTPUT_FILENAME='source-files'

# ISO的輸出封面名稱 _P.S. ISO 9660文件系統限制標題長度，不能超過32個字符_
OUTPUT_COVER_FILENAME='ubuntu-20.04.6-server-amd64-auto'

# auto install 預設檔案名稱 (備註：只要是方便切換方便切換 user-data)
AUTOINSTALL_FILENAME='server'

# 檔案輸出時間的預設格式
TIME=$(date +%Y%m%d_%H%M%S)

# Download網址 _P.S. 若有更新版本，就要更改下載網址_
# --- 20.04.6 ---
DOWNLOAD_STABLE_URL='https://releases.ubuntu.com/focal/ubuntu-20.04.6-live-server-amd64.iso'
DOWNLOAD_URL_UBUNTU_TW='https://ftp.ubuntu-tw.org/ubuntu-releases/20.04.6/ubuntu-20.04.6-live-server-amd64.iso'
DOWNLOAD_URL_NCTU_TW='http://ubuntu.cs.nctu.edu.tw/ubuntu-release/20.04.6/ubuntu-20.04.6-live-server-amd64.iso'
DOWNLOAD_URL_NCHC_TW='https://free.nchc.org.tw/ubuntu-cd/20.04.6/ubuntu-20.04.6-live-server-amd64.iso'
